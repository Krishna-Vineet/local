# ─── Server Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ─── App ─────────────────────────────────────────────────────────
PORT=5000

# ─── Database ────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/happypix

# ─── JWT Authentication ───────────────────────────────────────────
# Generate a strong random string (min 32 chars)
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_key_minimum_32_characters

# ─── AWS S3 (File Storage) ────────────────────────────────────────
# Get from: AWS IAM → Users → your user → Security credentials
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=your-s3-bucket-name

# ─── Razorpay (Payments) ──────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for testing, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── App URLs ─────────────────────────────────────────────────────
# Production: https://happypix.vercel.app
# Local dev:  http://localhost:5173
CLIENT_URL=http://localhost:5173

# Public URL of the CRM (used in emails / seeds)
CRM_URL=https://happypixcrm.vercel.app

# Extra CORS origins (comma separated) — add each deployment that
# talks to this API with credentials
# ALLOWED_ORIGINS=https://my-crm.example.com

# ─── Platform superadmin (seed scripts only) ──────────────────────
SUPERADMIN_EMAIL=owner@happypix.in
SUPERADMIN_PASSWORD=change-me-immediately

# ─── Email delivery (SendGrid) ────────────────────────────────────
# Required in production: OTP + notification emails. Without a key,
# OTP emails FAIL in production (codes are never leaked in responses).
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=no-reply@happypix.in

# ─── AI template backgrounds (optional) ───────────────────────────
# Together.ai FLUX.1-schnell — when unset, AI drafts fall back to a
# generated SVG background instead of a hosted image
TOGETHER_API_KEY=

# ─── Sessions ─────────────────────────────────────────────────────
# CRM session lifetime in minutes (default 480)
# SESSION_TTL_MIN=480

