# Happypix Booth — Environment Variables
# Copy this file to .env and fill in your values

# Server URL — existing Happypix backend
BOOTH_API_URL=https://happypix-gzy6.vercel.app

# Device token — get this from the Admin panel → Device Management
# Leave empty for manual passkey mode (no admin auto-assignment)
BOOTH_DEVICE_TOKEN=

# Razorpay Key ID (public) — get from Admin panel → Settings
RAZORPAY_KEY_ID=
