# ─── Photo Booth Client Environment Variables ─────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ─── API URL ─────────────────────────────────────────────────────
# Local dev:   http://localhost:5000
# Production:  https://your-api.vercel.app
VITE_API_URL=http://localhost:5000

# ─── Device Token ─────────────────────────────────────────────────
# Get this from Admin Panel → Devices → Add Device → copy token
# Each physical device must have its OWN unique token
# Format: hp_dev_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_DEVICE_TOKEN=hp_dev_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
