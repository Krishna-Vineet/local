# ─────────────────────────────────────────────────────────────────────────────
# HappyPix CRM — environment configuration
#
# Copy this file to `.env` (or `.env.local`, which is git-ignored) and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and
# every value is baked in AT BUILD TIME — rebuild after changing anything.
# Never put secrets here: everything in this file ships to the browser.
# ─────────────────────────────────────────────────────────────────────────────


# ── Data source ──────────────────────────────────────────────────────────────

# VITE_MOCK — which backend the CRM talks to.
#   true   (default) In-browser demo server with seeded data. Demo quick-login
#          chips, "Reset demo data", OTP codes shown on screen. Data lives in
#          localStorage (key happypix_crm_v2_db). Nothing leaves the browser.
#   false  Production. The mock server is NOT bundled at all; every request is
#          a real HTTP call to VITE_API_URL. No demo accounts, no demo UI, no
#          OTP codes on screen.
VITE_MOCK=false

# VITE_API_URL — base URL of the real HappyPix backend (used only when
# VITE_MOCK=false). Requests go to `${VITE_API_URL}/api/...`.
# Leave EMPTY to call the same origin the CRM is served from (e.g. nginx
# proxying /api to the backend) — the safest CORS-free setup.
VITE_API_URL=


# ── Session & login security (client-side hints; backend must enforce too) ──

# VITE_SESSION_TTL_MIN — how long a sign-in stays valid (minutes). The mock
# server expires tokens after this; the real backend should issue JWTs with a
# matching exp. Default 480 (8 hours). Minimum 5.
VITE_SESSION_TTL_MIN=480

# VITE_MAX_LOGIN_ATTEMPTS — failed sign-ins per email before a 15-minute
# lockout. Default 5. Minimum 3. Mirrors the throttle the backend must apply.
VITE_MAX_LOGIN_ATTEMPTS=5


# ── Branding & links ─────────────────────────────────────────────────────────

# VITE_WEBSITE_URL — public marketing site. Used by "Upgrade on website" on
# the Profile page and the login-screen footer link.
VITE_WEBSITE_URL=https://happypix.vercel.app

# VITE_SUPPORT_EMAIL — where clients are told to write when locked out or when
# the platform shows an error they cannot self-resolve.
VITE_SUPPORT_EMAIL=support@happypix.com


# ── Diagnostics ──────────────────────────────────────────────────────────────

# VITE_LOG_LEVEL — console verbosity of the API client.
#   silent | error | debug   (debug logs every request/response — dev only)
VITE_LOG_LEVEL=error
