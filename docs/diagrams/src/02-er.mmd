  ORGANIZATION ||--o{ EVENT : "runs"
  ORGANIZATION ||--o{ DEVICE : "owns"
  ORGANIZATION ||--o{ ORG_AI_TEMPLATE : "authors"
  ORGANIZATION ||--o{ COUPON : "issues"
  EVENT ||--o{ DEVICE : "assigned to"
  EVENT }o--o{ TEMPLATE : "uses"
  EVENT }o--o{ COUPON : "restricted to"
  TEMPLATE_LAYOUT ||--o{ TEMPLATE : "layout of"

%%@ d2-4 :: ER detail — money: payments, subscriptions, coupons and payouts
%%@ note: There is no single "revenue" collection. Payment rows are per booth transaction; Subscription rows are per platform plan purchase; Withdrawal rows are organisation payouts from the wallet balance.
%%@ note: Payment.settlement decides whether money goes to the organisation UPI directly or into the HappyPix wallet — the revenue dashboard splits every total on this field.
erDiagram
  PAYMENT {
    objectId _id PK
    objectId organizationId FK
    string razorpayOrderId
    string paymentLinkId "qr_* or plink_*"
    string paymentLinkUrl
    string razorpayPaymentId
    string razorpaySignature
    string gateway "razorpay or cashfree"
    string cashfreeOrderId
    string cashfreePaymentId
    string cashfreeQrData "raw UPI string"
    objectId eventId FK
    string eventName
    objectId deviceId FK
    string sessionId
    string guestPhone
    string settlement "upi or wallet"
    number amount "rupees"
    string currency
    number printCount
    boolean digitalCopy
    array photoUrls
    string compositeUrl
    string couponCode
    boolean couponCounted "idempotency for redemption"
    number discountApplied
    string status "created, pending, paid, failed"
    string utr "12-digit offline UPI reference"
    date createdAt
    date paidAt
  }
  SUBSCRIPTION {
    objectId _id PK
    objectId organizationId FK
    string plan
    number amount
    string invoiceNo UK
    date startDate
    date endDate
    string status
  }
  COUPON {
    objectId _id PK
    objectId organizationId FK
    string code
    string type
    number value
    number quantity
    number usedCount
    date expiryDate
    array eventIds FK
  }
  WITHDRAWAL {
    objectId _id PK
    objectId organizationId FK
    number amount "minimum 500"
    string status "processing, paid, failed"
    string upiId
    string reference
    objectId requestedBy FK
    date requestedAt
    date processedAt
    string note
  }
  ORGANIZATION ||--o{ PAYMENT : "earns"
  ORGANIZATION ||--o{ SUBSCRIPTION : "billed"
  ORGANIZATION ||--o{ WITHDRAWAL : "payouts"
  ORGANIZATION ||--o{ COUPON : "issues"
  EVENT ||--o{ PAYMENT : "earns"
  DEVICE ||--o{ PAYMENT : "collects"
  COUPON ||--o{ PAYMENT : "discounts"

%%@ d2-5 :: ER detail — media, digital delivery and TTL lifecycle
%%@ note: Four collections carry a MongoDB TTL index on expiresAt: PHOTO_SHARE, GUEST_DOWNLOAD, DIGITAL_TOKEN (and the index is declared, not cron-driven). Data disappears without any application write, so every reader must also check expiry explicitly.
%%@ note: PHOTO has no TTL — photo rows are permanent by design (a legacy TTL index on createdAt is actively dropped at boot). Its URL points at a private bucket, so readers must sign.
erDiagram
  PHOTO {
    objectId _id PK
    objectId organizationId FK "nullable for legacy captures"
    string s3Key
    string url "private bucket URL"
    string compositeUrl "final print strip"
    objectId eventId FK
    objectId deviceId FK
    string sessionId "dedupe key for gallery"
    boolean guestConsent "controls gallery visibility"
    date generatedAt
    boolean finalised
    string printStatus
    string digitalStatus
    date createdAt
  }
  PHOTO_SHARE {
    objectId _id PK
    objectId eventId FK
    objectId organizationId FK
    string tokenHash UK "32 random bytes, hex"
    array photoUrls
    string compositeUrl
    array photoIds FK
    date expiresAt "TTL"
    string status "active, expired, disabled"
    number viewCount
    number downloadCount
    number shareCount
    date createdAt
  }
  DIGITAL_TOKEN {
    objectId _id PK
    string token UK
    objectId paymentId FK
    array photoUrls
    string compositeUrl
    date expiresAt "TTL — 24 h"
    number downloadCount
    date createdAt
  }
  GUEST_DOWNLOAD {
    objectId _id PK
    string downloadId UK "18 random bytes base64url"
    objectId organizationId FK
    objectId eventId FK
    objectId deviceId FK
    string sessionId
    string compositeUrl
    array photoUrls
    array photoIds FK
    string eventName
    string organizationName
    date expiresAt "TTL — 24 h from session"
    number viewCount
    number downloadCount
    date createdAt
  }
  DELIVERY_RECORD {
    objectId _id PK
    objectId photoShareId FK
    objectId eventId FK
    objectId organizationId FK
    string method "QR, DOWNLOAD, WHATSAPP, EMAIL, SMS, NATIVE_SHARE, COPY_LINK"
    string destinationMasked
    string status "pending, sent, failed"
    string provider
    string providerMessageId
    string errorCode
    date sentAt
    date failedAt
  }
  EVENT ||--o{ PHOTO : "captures"
  EVENT ||--o{ PHOTO_SHARE : "shares"
  EVENT ||--o{ GUEST_DOWNLOAD : "delivers"
  EVENT ||--o{ DELIVERY_RECORD : "delivers"
  DEVICE ||--o{ PHOTO : "captures"
  PAYMENT ||--o| DIGITAL_TOKEN : "unlocks"
  PHOTO_SHARE ||--o{ DELIVERY_RECORD : "delivered as"
  PHOTO }o--o{ PHOTO_SHARE : "included in"
  PHOTO }o--o{ GUEST_DOWNLOAD : "included in"

%%@ d2-6 :: ER detail — support, leads and the audit trail
%%@ note: Three different support models exist and none of them is a duplicate: SUPPORT_TICKET is a guest or client ticket raised from a booth or website, TICKET is the org-side operational ticket, PLATFORM_SUPPORT_REQUEST is the org-to-platform escalation with an accept/deny/apply lifecycle.
%%@ note: AUDIT_LOG is append-only in practice: no route updates or deletes a row, and the actor name and role are denormalised so deleting a user never blanks history.
erDiagram
  SUPPORT_TICKET {
    objectId _id PK
    string ticketType "end_user or client"
    objectId organizationId FK
    string name
    string email
    string subject
    string message
    objectId eventId FK
    string eventShortCode
    objectId deviceId FK
    string sessionId
    string paymentReference
    boolean holdPhotos "blocks photo deletion"
    string status "open, in-progress, resolved, closed"
    string priority "low, normal, high, urgent"
    array adminNotes "text, createdAt"
    date resolvedAt
  }
  TICKET {
    objectId _id PK
    objectId organizationId FK
    objectId eventId FK
    objectId deviceId FK
    string category "device, payment, photo, event, general"
    string subject
    string priority
    string status "open, in_progress, resolved, closed"
    object guest "name, contact"
    object session
    array messages "author, at, text"
    string resolution
  }
  PLATFORM_SUPPORT_REQUEST {
    objectId _id PK
    string ticketNo "assigned on accept"
    objectId organizationId FK
    objectId createdBy FK
    string subject
    string category "technical, billing, account, feature, other"
    string priority "low, medium, high, urgent"
    string status "new, denied, open, in_progress, resolved"
    object decision "accepted or denied, reason, by, at"
    array messages "side org or platform, text, images"
    number reapplyCount
    object lastReapplication
    string resolution
    date acceptedAt
    date resolvedAt
  }
  WEBSITE_LEAD {
    objectId _id PK
    string name
    string email
    string phone
    string company
    string message
    string type "contact, demo, hardware, support"
    string status "new, contacted, closed"
    string notes
    date contactedAt
    date closedAt
  }
  AUDIT_LOG {
    objectId _id PK
    objectId organizationId FK "null = platform"
    objectId actorId FK "null = booth or system"
    string actorName
    string actorRole
    string action
    string entity
    string summary
    string severity
    string ip
    date at
  }
  ORGANIZATION ||--o{ SUPPORT_TICKET : "receives"
  ORGANIZATION ||--o{ TICKET : "receives"
  ORGANIZATION ||--o{ PLATFORM_SUPPORT_REQUEST : "raises"
  USER ||--o{ PLATFORM_SUPPORT_REQUEST : "creates"
  USER ||--o{ AUDIT_LOG : "acts in"
  ORGANIZATION ||--o{ AUDIT_LOG : "scopes"
  EVENT ||--o{ SUPPORT_TICKET : "about"
  DEVICE ||--o{ SUPPORT_TICKET : "raised at"
  EVENT ||--o{ TICKET : "about"
