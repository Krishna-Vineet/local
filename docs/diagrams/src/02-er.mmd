%%@ d2-3 :: ER detail — events, booths, templates and coupons
%%@ note: EVENT is the unit of booth work; DEVICE.assignedEventId is the single pointer that decides which event a booth is shooting. Deleting an event clears that pointer and detaches coupons.
%%@ note: Event-level gateway keys are overrides of the organisation defaults, which is why the same credential columns exist on both documents.
erDiagram
  EVENT {
    objectId _id PK
    objectId organizationId FK
    string name
    string clientName
    string location
    date startDate
    date endDate
    string status "upcoming, live, finished"
    boolean paused "paused beats live"
    array templateIds FK
    array filters
    boolean digitalCopy
    object layoutPrices
    object branding "logoUrl, tagline, up to 15 logos"
    string shortCode
    array assignedDeviceIds FK
    string passkey "booth join secret"
    number printPrice
    array printOptions
    boolean downloadEnabled
    boolean printingEnabled
    number boothTimeout
    number qrTimeoutMinutes
    string razorpayKeySecret "encrypted override"
    string cashfreeSecretKey "encrypted override"
    string gatewayPriority
    string upiId
    object sharingConfig "enabled, expirationDays"
    array enabledLayouts
    objectId assignedManagerId FK
    objectId createdBy FK
  }
  DEVICE {
    objectId _id PK
    objectId organizationId FK
    string deviceUuid UK "installation identity"
    string deviceName
    string location
    string deviceToken "legacy plaintext — migrated away"
    string deviceTokenHash "SHA-256"
    string operatorName
    string operatorPhone
    objectId assignedEventId FK
    date lastSeenAt
    string ipAddress
    string platform
    string appVersion
    object telemetry "prints, shutters, batteryPct"
    object connections "camera, printer, kioskScreen"
    string status "active, inactive, blocked"
  }
  TEMPLATE {
    objectId _id PK
    string name
    string category
    number price
    string layoutId FK
    string componentId
    object design
    string source "designer, playground, ai_generated"
    boolean active
    number usage
    objectId createdBy FK
  }
  TEMPLATE_LAYOUT {
    objectId _id PK
    string codeword UK
    object grid
    objectId createdBy FK
  }
  ORG_AI_TEMPLATE {
    objectId _id PK
    objectId organizationId FK
    string name
    string category
    number price
    object layout "code, familyId, slots, printSize"
    array slots
    object design
    array assets
    array versions
    string prompt
    string source
    object cache "indexedDb"
    objectId createdBy FK
  }
  COUPON {
    objectId _id PK
    objectId organizationId FK
    string code "unique per org"
    string type "percentage or fixed"
    number value
    number quantity
    number usedCount
    date expiryDate
    array eventIds FK
    string status "active or paused"
