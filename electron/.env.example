# HappyPix Booth (Electron) — environment
# Copy to `.env` (or `.env.local`) and point at your deployed backend.
#
# Production (recommended): the public URL of the HappyPix API.
VITE_BOOTH_API_URL=https://api.happypix.in

# Local development against the Express backend:
# VITE_BOOTH_API_URL=http://localhost:5000

# When VITE_BOOTH_API_URL is not set the app falls back to the built-in
# demo API, which never talks to a server and must NOT be used in
# production. Package the app only after configuring this variable.
