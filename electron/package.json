{
  "name": "booth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all -p dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build:react": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project ./src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build:react && electron-builder --mac --arm64",
    "dist:win": "npm run transpile:electron && npm run build:react && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && npm run build:react && electron-builder --linux --x64",
    "typecheck": "tsc -b --pretty",
    "verify": "npm run typecheck && npm run lint && npm test && npm run transpile:electron && npm run build:react",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.2"
  },
  "productName": "HappyPix Booth"
}
