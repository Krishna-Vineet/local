# ─── HappyPix website backend ───────────────────────────────
# Copy to .env. NEVER commit the real .env.
# IMPORTANT: MONGODB_URI must be the SAME database the main
# backend (backend/) uses — plans/users/orgs/downloads are shared.

PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/happypix

# Razorpay — same keys as backend/ uses for subscriptions
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Public website origin (used to build /download/:id links)
WEBSITE_PUBLIC_URL=https://happypix.in
# CRM buyers are sent to after checkout
CRM_URL=https://happypixcrm.vercel.app

# Extra CORS origins (comma separated), e.g. a Vercel preview URL
ALLOWED_ORIGINS=

# Shared secret for POST /api/internal/downloads (server-to-server only)
WEBSITE_INTERNAL_SECRET=change-me-long-random-string

# Cloudinary configuration (MUST match backend/ for consistent photo access)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
